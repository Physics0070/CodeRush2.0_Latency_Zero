# Frontend build-time config. Copy to .env.local for local overrides.
#
# Leave BLANK when FastAPI serves this bundle (the Docker image, and local dev
# on :7860). Relative /api paths then resolve to the same origin.
#
# Set it ONLY for split hosting - static frontend on Vercel/Netlify, backend on
# a container host:
#   VITE_API_BASE=https://<user>-<space>.hf.space
#
# The backend cannot run on Vercel or Netlify. Both are serverless with a 10s
# function timeout; this app holds SSE connections open and runs multi-minute
# graphs in background tasks. See docs/deployment.md.
VITE_API_BASE=
