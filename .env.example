# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# Every value here is intentionally blank.

# ---------- application ----------
APP_ENV=
LOG_LEVEL=
PORT=

# ---------- persistence (Turso / libSQL, ap-south-1) ----------
# ALL persistent state lives here. A Space/Render disk is ephemeral - store
# nothing locally. Apply migrations/001_events.sql before first use.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- model providers ----------
# Read ONLY by backend/providers/secret_broker.py. Never logged, never placed in
# an event payload, never sent to the frontend.
# LLM_PROVIDER selects which provider backend.api.routes._default_models()
# builds specs for. Only "ollama" is implemented.
LLM_PROVIDER=
# https://ollama.com for Ollama Cloud (adapter appends /api/chat itself), or
# http://localhost:11434 / a tunnelled URL for a local dev instance.
OLLAMA_BASE_URL=
# Required for Ollama Cloud, must be absent for an unauthenticated local
# instance - see backend/providers/ollama.py.
OLLAMA_API_KEY=
# Comma-separated model tags, no "ollama:" prefix. A local tag
# (llama3.2:3b) and a Cloud-only tag (qwen3-coder:480b-cloud) are
# interchangeable here - no code change needed either way.
OLLAMA_MODELS=
MAX_CONCURRENT_MODEL_CALLS=
# Groq/Gemini/OpenRouter adapters still exist and are reachable by explicitly
# passing a "groq:model" etc. spec in a request, but are not the default path.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- execution contract ----------
MAX_REPAIR_ATTEMPTS=
DEFAULT_SEED=
DEFAULT_TEMPERATURE=

# ---------- engine budgets ----------
DEFAULT_BUDGET_TOKENS=
DEFAULT_TIMEOUT_S=

# ---------- security ----------
SECRET_KEY=
CORS_ORIGINS=
# Exact origin of the deployed frontend (e.g. a Netlify site). Netlify preview
# subdomains are matched separately, in code, by .netlify.app suffix.
FRONTEND_ORIGIN=
MAX_UPLOAD_BYTES=

# ---------- rate limiting (slowapi) - no threshold is hardcoded ----------
RATE_LIMIT_AUTH=
RATE_LIMIT_PUBLIC=
RATE_LIMIT_AUTHED=
