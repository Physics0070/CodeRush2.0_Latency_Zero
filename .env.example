# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# Every value here is intentionally blank.

# ---------- application ----------
APP_ENV=
LOG_LEVEL=
PORT=

# ---------- persistence (Supabase Postgres, Mumbai / ap-south-1) ----------
# ALL persistent state lives here. HF Spaces disk is ephemeral - store nothing locally.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- model providers ----------
# Read ONLY by backend/providers/secret_broker.py. Never logged, never placed in
# an event payload, never sent to the frontend.
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# ---------- execution contract ----------
MAX_REPAIR_ATTEMPTS=
DEFAULT_SEED=
DEFAULT_TEMPERATURE=

# ---------- engine budgets ----------
DEFAULT_BUDGET_TOKENS=
DEFAULT_TIMEOUT_S=

# ---------- security ----------
SECRET_KEY=
CORS_ORIGINS=
MAX_UPLOAD_BYTES=

# ---------- rate limiting (slowapi) - no threshold is hardcoded ----------
RATE_LIMIT_AUTH=
RATE_LIMIT_PUBLIC=
RATE_LIMIT_AUTHED=
