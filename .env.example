# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# Every value here is intentionally blank.

# ---------- application ----------
APP_ENV=
LOG_LEVEL=
PORT=

# ---------- persistence (Turso / libSQL, ap-south-1) ----------
# ALL persistent state lives here. A Space/Render disk is ephemeral - store
# nothing locally. Apply migrations/001_events.sql before first use.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- model providers ----------
# Read ONLY by backend/providers/secret_broker.py. Never logged, never placed in
# an event payload, never sent to the frontend.
# backend.api.routes._default_models() builds specs from EVERY configured
# provider below, Ollama first (chairman/fast path) - Groq and Gemini widen
# the council with a different model family each when their keys are set.
# Ollama alone is a complete, working configuration; the others are additive.
LLM_PROVIDER=
# https://ollama.com for Ollama Cloud (adapter appends /api/chat itself), or
# http://localhost:11434 / a tunnelled URL for a local dev instance.
OLLAMA_BASE_URL=
# Required for Ollama Cloud, must be absent for an unauthenticated local
# instance - see backend/providers/ollama.py.
OLLAMA_API_KEY=
# Comma-separated model tags, no "ollama:" prefix. A local tag (llama3.2:3b)
# and a Cloud-only tag (gpt-oss:120b-cloud) are interchangeable here - no
# code change needed either way. Test any new tag against a real key first:
# not every advertised Cloud model is actually enabled per account.
OLLAMA_MODELS=
MAX_CONCURRENT_MODEL_CALLS=
GROQ_API_KEY=
GEMINI_API_KEY=
# OpenRouter adapter still exists and is reachable by explicitly passing an
# "openrouter:model" spec in a request, but is not part of the default mix.
OPENROUTER_API_KEY=

# ---------- execution contract ----------
MAX_REPAIR_ATTEMPTS=
DEFAULT_SEED=
DEFAULT_TEMPERATURE=

# ---------- engine budgets ----------
DEFAULT_BUDGET_TOKENS=
DEFAULT_TIMEOUT_S=

# ---------- security ----------
SECRET_KEY=
CORS_ORIGINS=
# Exact origin of the deployed frontend (e.g. a Netlify site). Netlify preview
# subdomains are matched separately, in code, by .netlify.app suffix.
FRONTEND_ORIGIN=
MAX_UPLOAD_BYTES=

# ---------- rate limiting (slowapi) - no threshold is hardcoded ----------
RATE_LIMIT_AUTH=
RATE_LIMIT_PUBLIC=
RATE_LIMIT_AUTHED=
